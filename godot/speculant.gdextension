[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://bin/macos/libspeculant_godot.dylib"
macos.release = "res://bin/macos/libspeculant_godot.dylib"
linux.debug.x86_64 = "res://bin/linux-x86_64/libspeculant_godot.so"
linux.release.x86_64 = "res://bin/linux-x86_64/libspeculant_godot.so"
linux.debug.arm64 = "res://bin/linux-aarch64/libspeculant_godot.so"
linux.release.arm64 = "res://bin/linux-aarch64/libspeculant_godot.so"
windows.debug.x86_64 = "res://bin/windows-x86_64/speculant_godot.dll"
windows.release.x86_64 = "res://bin/windows-x86_64/speculant_godot.dll"
